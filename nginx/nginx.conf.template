worker_processes auto;
rtmp_auto_push on;
rtmp_auto_push_reconnect 1s;

events {}

# Stream block for Port Fusion (SNI-based routing)
stream {
    map $ssl_preread_server_name $backend_name {
        ${SERVER_DOMAIN}  http_backend;
        default           rtmp_backend;
    }

    upstream http_backend {
        server 127.0.0.1:8443;
    }

    upstream rtmp_backend {
        server 127.0.0.1:19352;
    }

    server {
        listen 1935;
        proxy_pass $backend_name;
        proxy_protocol on;
        ssl_preread on;
    }
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # Cloudflare Real IP (IPv4 & IPv6)
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    # HTTP Server (Port 80)
    server {
        listen 80 default_server;
        server_name ${SERVER_DOMAIN} _;

        # ACME Challenge for Certbot
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Serve static chat.html directly
        location = /chat.html {
            root /usr/local/nginx/html;
        }

        location /yt_video_id {
            proxy_pass http://127.0.0.1:8082/yt_video_id;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:8082/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /health {
            proxy_pass http://127.0.0.1:8082/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Serve SPA React Dashboard & Combined Chat Config Page
        location / {
            root /usr/local/nginx/html;
            index index.html;
            try_files $uri $uri/ /index.html;
        }

        # Internal Stats for localhost
        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location /stat.xsl {
            root /usr/local/nginx/html;
        }
    }

    # HTTPS Server (Internal Port 8443, Fused from 443)
    server {
        listen 8443 ssl default_server;
        server_name ${SERVER_DOMAIN} _;

        ssl_certificate /etc/letsencrypt/live/${SERVER_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${SERVER_DOMAIN}/privkey.pem;

        # Hardened SSL Settings
        ssl_protocols TLSv1.3;
        ssl_conf_command Ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256;
        ssl_prefer_server_ciphers off;

        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location /stat.xsl {
            root /usr/local/nginx/html;
        }

        location = /chat.html {
            root /usr/local/nginx/html;
        }

        location /yt_video_id {
            proxy_pass http://127.0.0.1:8082/yt_video_id;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:8082/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /health {
            proxy_pass http://127.0.0.1:8082/health;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            root /usr/local/nginx/html;
            index index.html;
            try_files $uri $uri/ /index.html;
        }
    }

    # Stats and Control for NOALBS (Internal Port 8081)
    server {
        listen 8081;
        allow 127.0.0.1;
        deny all;

        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location /control {
            rtmp_control all;
        }
    }
}

rtmp {
    server {
        listen 19352 proxy_protocol;
        listen 19359;
        chunk_size ${CHUNK_SIZE};

        # Throughput and Buffer Optimization for Upload Speeds
        max_message 10M;
        out_queue 4096;
        out_cork 8;

        # Stability and Security Enhancements
        ping 15s;
        ping_timeout 5s;
        drop_idle_publisher 4s;
        allow play 127.0.0.1;
        deny play all;

        # Generic live application (Ingest & Direct Multistream Push)
        application ${APP_NAME} {
            live on;
            record off;
            allow play 127.0.0.1;
            allow publish all;
            on_publish http://127.0.0.1:8082/validate?key=$name;
            on_publish_done http://127.0.0.1:8082/publish_done;

            #youtube
            #facebook
            #instagram
            #tiktok
            #kick
            #x
            #twitch
            #trovo
            #rtmp1
            #rtmp2
            #rtmp3
        }

        # Vertical application (Ingest & Direct Multistream Push)
        application vertical {
            live on;
            record off;
            allow play 127.0.0.1;
            allow publish all;
            on_publish http://127.0.0.1:8082/validate?key=$name;
            on_publish_done http://127.0.0.1:8082/publish_done;

            #v_youtube
            #v_facebook
            #v_instagram
            #v_tiktok
            #v_kick
            #v_x
            #v_twitch
            #v_trovo
            #v_rtmp1
        }
    }
}
